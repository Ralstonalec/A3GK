# ─────────────────────────────────────────────────────────────────────────────
# A3GK — environment template.  Copy to `.env.local` for local work, or add the
# same names in Vercel → Project → Settings → Environment Variables.
#
# EVERYTHING BELOW IS OPTIONAL.  With no variables set the site runs in "demo
# mode": mock catalog, in-memory cache, demo checkout (no payment taken).
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle — never put
# a secret in one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify ──────────────────────────────────────────────────────────────────
# Storefront API (products, cart).  The storefront token is designed to be public.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Pin the API version you tested against (defaults to the version in lib/config.js)
SHOPIFY_API_VERSION=
# Admin app credentials (server only).  The secret also verifies webhook HMACs
# and App Bridge session tokens.
SHOPIFY_ADMIN_API_KEY=
SHOPIFY_ADMIN_API_SECRET=
# Only if webhooks are created in Shopify Admin → Settings → Notifications (they are
# signed with their own secret). App-created webhooks use SHOPIFY_ADMIN_API_SECRET.
SHOPIFY_WEBHOOK_SECRET=

# ── Payments (Stripe Checkout) ───────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
# Signing secret of the webhook endpoint https://<domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Analytics (server-side GA4 Measurement Protocol; consent-gated) ──────────
NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXX
GA_API_SECRET=
# Optional: also forward every event to your own collector (Segment, PostHog, n8n…)
ANALYTICS_WEBHOOK_URL=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin.  On Vercel this is derived automatically from
# VERCEL_PROJECT_PRODUCTION_URL, so you normally leave it empty.
NEXT_PUBLIC_SITE_URL=
# Leave EMPTY to call same-origin /api (recommended; correct on preview deploys).
# Only set if the API is hosted on another origin — you must then add CORS.
NEXT_PUBLIC_API_URL=

# ── Cache / rate-limit store (Upstash Redis via Vercel Marketplace) ──────────
# Either pair works. Without these, an in-memory store is used (fine for demos,
# but not shared between serverless instances).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Media / social ───────────────────────────────────────────────────────────
# Optional full-screen hero video (mp4/webm). Falls back to the 3D scene.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_VIDEO_POSTER=
# Extra https origins allowed to serve <video>/<audio> (space separated), e.g. your CDN
CSP_MEDIA_HOSTS=
# Instagram Graph API long-lived token for the live social feed
INSTAGRAM_ACCESS_TOKEN=
