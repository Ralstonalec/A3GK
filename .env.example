# Shopify Storefront API (Headless channel). Leave blank to run with unconnected placeholder data.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
NEXT_PUBLIC_SITE_URL=https://example.com

# Shopify Customer Account API (store accounts: order history, details). Public client id from the Headless channel.
# Callback URL, JavaScript origin and logout URL must be registered in Shopify first (docs/SHOPIFY-ACCOUNTS.md).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Set to 1 to show the account icon when only store accounts are used (no Supabase).
NEXT_PUBLIC_CUSTOMER_ACCOUNTS=

# Supabase (customer accounts, saved sizes, saved items, contact form). Leave blank to hide accounts.
NEXT_PUBLIC_SUPABASE_URL=https://ovvoliwggdsqbgtjobut.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (set in Vercel; never prefix with NEXT_PUBLIC_). Needed for order history and email unsubscribe.
SUPABASE_SERVICE_ROLE_KEY=
SHOPIFY_WEBHOOK_SECRET=
