{
  "name": "a3gk-website",
  "version": "1.0.0",
  "private": true,
  "description": "A3GK \u2014 Advanced Athletic Gear for Goalkeepers. Next.js storefront prototype, ready to port to a Shopify theme.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-assets.mjs",
    "theme:sync": "node scripts/sync-theme-assets.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "verify:shopify": "node scripts/verify-shopify.mjs",
    "verify:webhook": "node scripts/test-shopify-webhook.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:pa11y": "pa11y-ci --config .pa11yci.json",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "package": "node scripts/package.mjs",
    "audit:motion": "node scripts/motion-check.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "framer-motion": "^14.1.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "isomorphic-dompurify": "^3.19.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "swr": "^2.5.1",
    "three": "^0.186.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "^1.0.11",
    "@shopify/theme-check-node": "^3.30.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "axe-core": "^4.14.0",
    "cypress": "^16.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lighthouse": "^13.5.0",
    "node-mocks-http": "^1.18.1",
    "pa11y": "^10.0.0",
    "pa11y-ci": "^5.0.0",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5"
  }
}
